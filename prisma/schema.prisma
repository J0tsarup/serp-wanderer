generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  username         String            @unique
  passwordHash     String
  createdAt        DateTime          @default(now())
  domains          Domain[]
  settings         Settings?
  sessions         Session[]
  googleConnection GoogleConnection?
}

// A session token stored in an httpOnly cookie. Deleting the row logs the
// device out; expired rows are just ignored (not actively swept), which is
// fine at this scale.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Domain {
  id        String     @id @default(cuid())
  userId    String?    // nullable only to support the one-time migration from pre-auth data — see signup route, which claims orphaned rows for the first account created
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String     // e.g. "hardypaw.com" — bare hostname, no protocol/www
  gscSiteUrl String?   // Search Console property for this domain, e.g. "sc-domain:hardypaw.com"; null = use the account's property only if it covers this domain
  createdAt DateTime   @default(now())
  keywords  Keyword[]

  @@index([userId])
}

model Keyword {
  id         String      @id @default(cuid())
  domainId   String
  domain     Domain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  term       String
  country    String      @default("us") // Bright Data "gl" param, lowercase ISO 2-letter
  language   String      @default("en") // Bright Data "hl" param
  device     String      @default("desktop") // "desktop" | "mobile"
  location   String?     // optional city-level targeting — Google Ads canonical geo-target name, e.g. "Los Angeles,California,United States"
  tags       String[]    @default([]) // free-form labels for filtering/grouping
  serpSnapshot Json?     // Google results seen in the latest successful check (lib/serp/snapshot.ts) — shown in the keyword panel
  createdAt  DateTime    @default(now())
  checks     RankCheck[]

  @@index([domainId])
}

model RankCheck {
  id         String   @id @default(cuid())
  keywordId  String
  keyword    Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  position   Int?     // null = not found in the results we fetched
  url        String?  // the ranking URL that matched, if found
  error      String?  // set when the check itself failed (Bright Data error, timeout) — distinguishes "check failed" from "not ranking", which both have a null position
  checkedAt  DateTime @default(now())

  @@index([keywordId, checkedAt])
}

// One row per user holding their own Google OAuth client credentials (from
// their own Google Cloud project — same pattern as Bright Data) and the
// resulting tokens once they connect Search Console.
model GoogleConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String?
  clientSecret String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  siteUrl      String?   // the Search Console property chosen after connecting, e.g. "sc-domain:hardypaw.com"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One row per user, holding their own Bright Data credentials and defaults
// entered through the Settings page — so the app can run without any
// secrets in env vars, and each account brings its own Bright Data usage.
model Settings {
  id               String   @id @default(cuid())
  userId           String?  @unique // nullable only to support the one-time migration from pre-auth data — see signup route
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  serpProvider        String   @default("brightdata") // "brightdata" | "scrapingrobot" — which API runs rank checks
  brightdataApiKey    String?
  brightdataZone      String?
  scrapingRobotToken  String?
  scrapingRobotRender Boolean  @default(false) // use Scraping Robot's JS-rendering module (HtmlChromeScraper)
  defaultCountry   String   @default("us")
  defaultLanguage  String   @default("en")
  defaultLocation  String?  // optional default city (US only for now) — same canonical-name format as Keyword.location
  maxCheckDepth    Int      @default(10) // how many Google result positions to check (10, 30, 50, or 100) — 10 by default (a single Bright Data request) since Vercel's free plan has a hard ~10s execution limit that deeper, multi-request checks risk exceeding; raise it in Settings if you're on Pro
  resendApiKey     String?  // for the weekly Search Console email digest
  digestEmail      String?  // recipient address for the digest
  digestEnabled    Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}
